# H07 (readiness assessment): backup/archive hygiene — these patterns
# prevent accidental commits of database dumps, key exports, and other
# sensitive artifacts regardless of where they're placed in the tree.
# Backups belong OUTSIDE the repo, encrypted.
*.sql.gz
*.dump
*.pgdump
*.sql.dump
*.backup
*.bak
*.secret
*.key.pem
*.pem.key
env-backup/
backups/
*.env.backup
*.env.bak
secrets/


# Generated report PDFs — regenerate with tools/md_report_to_html.py +
# tools/html_reports_to_pdf.py (headless Chrome), then verify page counts.
docs/reports/pdf/

# Raw page dumps captured while researching the market reports. The citable
# evidence lives in docs/market-research/verification/*/ (ledgers + quotes);
# these are the re-fetchable extraction artifacts behind them.
docs/market-research/*-evidence/

# H07: a compressed copy of a dump or an env backup used to escape the deny list.
*.zip
*.tar.gz
*.tgz
*.7z

# .dockerignore is a project file, not a dotfile to hide.
!.dockerignore

# Decision 2 (2026-09-18): the rendered HTML is a build artifact, like the PDFs.
docs/reports/html/

# generated from data/ontologies/_sources/SBS_V2_Code_list.xlsx (2.5 MB)
# regenerate with: uv run --with openpyxl python tools/build_sbs_catalog.py
data/ontologies/nphies_services.json

# dev-stack supervisor logs
dev-logs/

# Scratch material from research runs: kept on disk, not in the repository.
docs/market-research/_scratch/
