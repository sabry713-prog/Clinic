# Build context: the REPOSITORY ROOT (docker-compose.demo.yml sets `context: .`).
#
# This project's Python packages are path dependencies (../../packages/<name>),
# so an app-directory context cannot resolve them and uv aborts the build with
# "cannot normalize a relative path beyond the base directory:
# /app/../../packages/blocklist". The layout below reproduces the repository
# paths inside the image so those dependencies resolve.
FROM python:3.12-slim

WORKDIR /app
RUN pip install --no-cache-dir uv

COPY packages/ ./packages/
COPY services/nphies-engine/ ./services/nphies-engine/

WORKDIR /app/services/nphies-engine
# --frozen uses the committed lockfile; the fallback re-resolves if it is stale.
RUN uv sync --frozen --no-dev || uv sync --no-dev

EXPOSE 5006
CMD ["uv", "run", "uvicorn", "api_router:app", "--host", "0.0.0.0", "--port", "5006"]
