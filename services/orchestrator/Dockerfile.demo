# Build context: the REPOSITORY ROOT (docker-compose.demo.yml sets `context: .`).
#
# Two things the image needs from the repository, both of which an app-directory
# context cannot see:
#   * the Python packages, which are path dependencies (../../packages/<name>);
#     without them uv aborts with "cannot normalize a relative path beyond the
#     base directory";
#   * docs/prompts, because packages/prompt_loader resolves the prompt templates
#     by path from the repository root, and without them the service dies at
#     import with FileNotFoundError.
FROM python:3.12-slim

WORKDIR /app
RUN pip install --no-cache-dir uv

COPY packages/ ./packages/
COPY docs/prompts/ ./docs/prompts/
COPY services/orchestrator/ ./services/orchestrator/

WORKDIR /app/services/orchestrator
# --frozen uses the committed lockfile; the fallback re-resolves if it is stale.
RUN uv sync --frozen --no-dev || uv sync --no-dev

EXPOSE 5005
CMD ["uv", "run", "uvicorn", "agent_handlers:app", "--host", "0.0.0.0", "--port", "5005"]
